# Maintainer: FreidhYMorales
pkgname=delta
pkgver=0.3.0
pkgrel=1
pkgdesc="Editor y simulador de automatas: finitos, Mealy, Moore, pila y maquinas de Turing"
arch=('x86_64')
url="https://github.com/FreidhYMorales/delta"
license=('MIT')
depends=('webkit2gtk-4.1' 'gtk3' 'librsvg' 'libayatana-appindicator')
makedepends=('rust' 'nodejs' 'npm' 'pkgconf')
source=("git+${url}.git#tag=v${pkgver}")
sha256sums=('SKIP')

build() {
  cd "$srcdir/delta"
  npm ci --prefix frontend
  npm run build --prefix frontend
  cargo build --release --locked -p app
}

package() {
  cd "$srcdir/delta"

  install -Dm755 target/release/app "$pkgdir/usr/bin/delta"

  install -Dm644 src-tauri/icons/32x32.png \
    "$pkgdir/usr/share/icons/hicolor/32x32/apps/delta.png"
  install -Dm644 src-tauri/icons/128x128.png \
    "$pkgdir/usr/share/icons/hicolor/128x128/apps/delta.png"

  install -d "$pkgdir/usr/share/applications"
  cat > "$pkgdir/usr/share/applications/delta.desktop" <<EOF
[Desktop Entry]
Type=Application
Name=Delta
Comment=Editor y simulador de automatas
Exec=delta
Icon=delta
Terminal=false
Categories=Education;Science;
EOF

  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
